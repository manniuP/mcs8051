# ===== 顶层结构（分类）=====
#   compiler/  MCS 后端编译器源码（Zig + 目标定义）
#   lib/       可复用库与头文件（mcs251.zig、cobs/、uart251/、stc-hal/、include/、crt0/）
#   examples/  各示例工程
#   docs/      文档
#   tools/     构建/辅助工具与预编译工具链（sdcc-mcs251-windows-x64/、vendor/）

# Local build outputs
/out/
/build/
/zig.master-1415.bak
/tools/wsl_build_sdcc.sh

# Zig 编译器构建产物与缓存（compiler/ 是源码）
/compiler/zig-out/
/compiler/zig-dbg-out/
/compiler/stage3-out/
/compiler/.zig-cache*/
# 上游之外误入 compiler/ 的本地杂物
/compiler/build_options.zig
/compiler/session-ses_f65c.md
/compiler/test.obj

# SDCC 上游 fork 源码与预编译产物（独立管理；工具链已移到 tools/ 下）
/sdcc-c251/
/docs-c251/
/sdcc-c251-build.log
/tools/sdcc-mcs251-windows-x64/

# STC 官方 SDK / 受版权资料（本机存放，不提交）
/tools/vendor/

# 旧构建脚本（已被 xmake.lua 取代）；示例内的遗留脚本
/examples/ai8051u/blink/build.ps1

# 构建产物（sdcc/sdas/sdld 输出）
*.ihx
*.rel
*.lk
*.mem
*.rst
*.sym
*.lst
*.dumpcustom*
*.map
*.cdb

# 构建产物（.asm/.rel/.ihx/.cdb 等）集中在 build/examples/（见 /build/ 规则）
# 源码目录里只留源文件；.asm 源仅 crt0*.asm 与手工参考（ptrtest_correct/test_dr28）
# 差分回归中间产物（MCS_KEEP_BASE=1，见 tools/mcs_regress.py）
*.asm.base
# 合并编译单元（amalgamation）时 SDCC 在源旁产 .asm
/examples/ai8051u/usb_hid/src/*.asm
# 例外：手工编写的参考 asm（非构建产物）

# ptrtest 调试/构建产物（仅 ptrtest.zig 与 main.c 是源）
/examples/ai8051u/ptrtest/*.txt
/examples/ai8051u/ptrtest/*.log
/examples/ai8051u/ptrtest/*.ihex
/examples/ai8051u/ptrtest/ptrtest
/examples/ai8051u/ptrtest/noptr
/examples/ai8051u/ptrtest/noptr.zig
/examples/ai8051u/ptrtest/simple
/examples/ai8051u/ptrtest/simple.zig
/examples/ai8051u/ptrtest/simplest
/examples/ai8051u/ptrtest/simplest.zig
/examples/ai8051u/ptrtest/empty.zig
/examples/ai8051u/ptrtest/min.ihex
/examples/ai8051u/ptrtest/min.zig

# cobs 主机测试产物
/lib/cobs/*.exe
# cordic 主机测试产物
/lib/cordic/*.exe

# 由源码打包的 SDCC 库（生成物）
/examples/ai8051u/usb_cdc/*.lib

# USB 示例：SDCC 由 .c 生成的汇编（.c 是源）
__pycache__/

# Zig / xmake 构建缓存
.zig-cache/
*.zig-cache*/
.xmake/

# Editors / OS
.vs/
.vscode/
*.user
Thumbs.db
desktop.ini

# 例外：VSCode 示例工程保留 .vscode 配置
!/examples/vscode_c_cmake/.vscode/
!/examples/vscode_c_cmake/.vscode/**
!/examples/vscode_mixed_xmake_zig/.vscode/
!/examples/vscode_mixed_xmake_zig/.vscode/**
